# サーバーポート(ローカル/Docker実行時のみ使用。Vercelでは不要)
PORT=3000

# JWT署名用の秘密鍵(本番環境では必ず長いランダム文字列に変更してください)
JWT_SECRET=please-change-this-to-a-long-random-secret-string

# PostgreSQL接続文字列
# Vercel Postgres(Neon)をVercelプロジェクトに接続すると自動的に設定されます。
# ローカルやDockerで使う場合は、ご自身のPostgres接続文字列を指定してください。
# 例: postgres://user:password@host:5432/dbname?sslmode=require
POSTGRES_URL=

# /setup.html から管理者アカウントを作成・追加するための合言葉(任意)
# 社員が1人も登録されていない状態では不要ですが、既に社員が登録された後に
# 追加の管理者を作成したい場合、ここに設定した文字列を画面で入力する必要があります。
ADMIN_SETUP_KEY=
